  "rules": [
    {
      "name": "signal_actions_imply_signal_tampering",
      "head": {
        "predicate": "signal_tampering",
        "value": true
      },
      "body": {
        "any_of_groups": [
          [
            {
              "predicate": "swaps_blue_signal_tile",
              "value": true
            },
            {
              "predicate": "lights_reverse_tunnel_lamp",
              "value": true
            },
            {
              "predicate": "inserts_red_route_key",
              "value": true
            },
            {
              "predicate": "flips_black_signal_lever",
              "value": true
            }
          ]
        ]
      },
      "natural_text": "Signal tampering includes swapping a blue signal tile, lighting a reverse tunnel lamp, inserting a red route key, or flipping a black signal lever."
    },
    {
      "name": "track_change_implies_train_rerouting",
      "head": {
        "predicate": "train_rerouting",
        "value": true
      },
      "body": {
        "any_of_groups": [
          [
            {
              "predicate": "ghost_train_changes_track",
              "value": true
            },
            {
              "predicate": "dispatch_board_repaints_route",
              "value": true
            }
          ]
        ]
      },
      "natural_text": "Train rerouting is present when the ghost train changes track or the dispatch board repaints the route."
    },
    {
      "name": "tampering_and_rerouting_imply_route_misdirection_risk",
